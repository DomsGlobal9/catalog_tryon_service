datasource db {
  provider = "postgresql"
  schemas  = ["se_catalog"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

// ─── 1. AI MODELS (The Default Poses) ───
// Stores the 4 base reference images for every model we offer.
model AiModel {
  id             String    @id
  name           String    // e.g., "Model 1 (Female)"
  gender         String    @default("female")
  isActive       Boolean   @default(true) @map("is_active")
  category       String?
  
  // The crucial base images for the 4 views
  frontBaseUrl   String    @map("front_base_url")
  backBaseUrl    String    @map("back_base_url")
  sittingBaseUrl String    @map("sitting_base_url")   // Used for Sitting View
  sideBaseUrl    String    @map("side_base_url")  // Used for Side View

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  jobs           DrapeJob[]

  @@map("draping_models")
  @@schema("se_catalog")
}

// ─── 2. DRAPING JOBS (Generation History & Logging) ───
// Tracks every request made to the API, storing inputs and outputs.
model DrapeJob {
  id                  String   @id @default(uuid())
  
  // Client ID comes from the Super Admin Gateway header.
  clientId            String   @map("client_id") 
  
  // Which AI model did they select?
  modelId             String   @map("model_id")
  model               AiModel  @relation(fields: [modelId], references: [id], onDelete: Restrict)

  status              String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  
  // Note: Input and Output images are intentionally NOT stored in the database.
  // The API operates on a Base64-in, Base64-out model for data privacy, 
  // so we only log the metadata of the job for billing/auditing purposes.

  // Diagnostics
  errorMessage        String?  @db.Text @map("error_message")
  latencyMs           Int?     @map("latency_ms")

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([clientId])
  @@map("draping_jobs")
  @@schema("se_catalog")
}

// ─── 3. SHARED STATE (lets several servers run behind a load balancer) ───
// Written with plain SQL by src/lib/shared, which also creates these tables at
// boot if they are missing. They are declared here so `prisma db push` keeps
// them instead of dropping them. Every row is short-lived and safe to lose.

// Rate limit counters: units used per bucket per time window.
model SharedRateLimit {
  bucket      String
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  used        Int
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([bucket, windowStart])
  @@index([expiresAt])
  @@map("shared_rate_limits")
  @@schema("se_catalog")
}

// Cache entries shared between servers (e.g. design discovery search results).
model SharedCache {
  cacheKey  String   @id @map("cache_key")
  value     Json     @db.Json
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("shared_cache")
  @@schema("se_catalog")
}

// Generation jobs currently running, on any server, so a cancel reaches them.
model ActiveJob {
  jobId           String   @id @map("job_id")
  jobKey          String   @map("job_key")
  pipeline        String
  instanceId      String   @map("instance_id")
  cancelRequested Boolean  @default(false) @map("cancel_requested")
  startedAt       DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  heartbeatAt     DateTime @default(now()) @map("heartbeat_at") @db.Timestamptz(6)

  @@index([jobKey])
  @@map("active_jobs")
  @@schema("se_catalog")
}

// ─── 4. BILLABLE RUNS (what a third party is charged for) ───
// One row per FULLY delivered run, written by src/modules/billing when the run
// completes. A failed, cancelled or partial run writes nothing. The Gateway
// (Platform Console) reads these through GET /internal/billing/usage, prices
// them and makes the monthly bill; nothing about money is decided here.
// `kind` is plain text on purpose (CATALOG | COLOUR_VARIANT): a new kind must
// never need a database enum change. The garment photo is never stored, only
// a hash of it in garment_ref so colour runs can be grouped under their garment.
model BillableRun {
  id               String   @id @default(uuid())
  clientId         String   @map("client_id")
  kind             String
  // Caller's jobId ("job:<id>"), else the Gateway request id ("req:<id>").
  // Unique per client, so the same request retried is charged once.
  requestKey       String   @map("request_key")
  colourName       String?  @map("colour_name")
  colourHex        String?  @map("colour_hex")
  garmentRef       String?  @map("garment_ref")
  views            Int
  drapeJobId       String?  @map("drape_job_id")
  gatewayRequestId String?  @map("gateway_request_id")
  deliveredAt      DateTime @default(now()) @map("delivered_at") @db.Timestamptz(6)

  @@unique([clientId, requestKey])
  @@index([clientId, deliveredAt])
  @@map("billable_runs")
  @@schema("se_catalog")
}
